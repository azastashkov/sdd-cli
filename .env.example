# Copy to .env, fill in the real key, and `source .env` (or use direnv).
# .env is git-ignored — NEVER commit the real key.
export DEEPSEEK_API_KEY=sk-REPLACE_ME

# Jira/Confluence/Bitbucket site URLs and personal access tokens for the atlassian: block in
# sdd.yml (see sdd.yml.example). Tokens expire and get reissued more often than a model API key,
# and a corporate user typically has one shell profile (~/.zshrc) shared across many sdd
# workspaces, so ~/.zshrc — not a per-workspace .env — is the recommended home for these six
# specifically.
export JIRA_URL=https://jira.corp.local
export JIRA_API_KEY=REPLACE_ME
export CONFLUENCE_URL=https://confluence.corp.local
export CONFLUENCE_API_KEY=REPLACE_ME
export BITBUCKET_URL=https://bitbucket.corp.local
export BITBUCKET_API_KEY=REPLACE_ME

# Model gateway over mutual TLS, for the "CLOSED CORPORATE NETWORK" models: blocks in
# sdd.yml.example — cert/key/password paths, never the private key or password itself.
export MODEL_URL=https://model-gateway.corp.local
export MODEL_CERT_PATH=/path/to/client.crt
export MODEL_KEY_PATH=/path/to/client.key
export MODEL_KEY_PASSWORD=REPLACE_ME
export MODEL_TRUSTSTORE_PASSWORD=REPLACE_ME

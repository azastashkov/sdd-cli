# Copy to .env, fill in the real key, and `source .env` (or use direnv).
# .env is git-ignored — NEVER commit the real key.
export DEEPSEEK_API_KEY=sk-REPLACE_ME

# Jira/Confluence/Bitbucket personal access tokens for the atlassian: block in sdd.yml (see
# sdd.yml.example). These expire and get reissued more often than a model API key, and a
# corporate user typically has one shell profile (~/.zshrc) shared across many sdd workspaces, so
# ~/.zshrc — not a per-workspace .env — is the recommended home for these three specifically.
export JIRA_PAT=REPLACE_ME
export CONFLUENCE_PAT=REPLACE_ME
export BITBUCKET_PAT=REPLACE_ME

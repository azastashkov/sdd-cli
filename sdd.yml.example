# Copy to <workspace>/sdd.yml — the directory containing all estate checkouts.
retrieval: fts            # fts is the only backend that exists — every command retrieves with
                          # SQLite FTS5. `embeddings` is rejected at load time rather than
                          # accepted and ignored: there is no embeddings backend to honor it.
                          # This key can be omitted; fts is the default.

# Every key under `models:` is an endpoint you can name in `run.escalation_ladder`.
# `planner` is also used directly for impact seeding and Gate-1 plan drafting, and
# `coder` for repo cards, so keep both defined even if the ladder names others.
#
# api_key resolves ${ENV_VAR} at load time. Read-only commands (review, status,
# clean) never call a model and never need the credential; implement, plan, index
# and doctor fail at first use if it is missing.
models:
  flash:                  # tier 1: cheapest capable model — most repos resolve here
    base_url: https://routerai.ru/api/v1
    model: qwen/qwen3.5-flash-02-23
    api_key: ${ROUTER_AI_API_KEY}
    max_tokens: 8192
    extra_body:
      # Thinking models spend the whole completion budget on reasoning and return
      # finish_reason=length with empty content. Disable it for structured work.
      chat_template_kwargs:
        enable_thinking: false
  coder:                  # tier 2: larger model for repos tier 1 could not finish
    base_url: https://routerai.ru/api/v1
    model: qwen/qwen3.5-397b-a17b
    api_key: ${ROUTER_AI_API_KEY}
    max_tokens: 8192
    extra_body:
      chat_template_kwargs:
        enable_thinking: false
  planner:                # tier 3, and the whole-estate synthesis model
    base_url: https://api.deepseek.com/v1
    model: deepseek-v4-flash
    api_key: ${DEEPSEEK_API_KEY}
    # drafting a Gate-1 plan needs ~2x the seeding budget; 16384 truncates on medium estates
    max_tokens: 32768
  pro:                    # tier 4: last resort
    base_url: https://api.deepseek.com/v1
    model: deepseek-v4-pro
    api_key: ${DEEPSEEK_API_KEY}
    max_tokens: 32768

  # Local alternative for `coder` (Apple Silicon, ~40 GB): run scripts/serve-qwen.sh
  # and REPLACE the `coder:` block above with the one below — do not uncomment it
  # here, or `models:` ends up with two `coder:` keys. Keeps every token on the
  # machine.
  # coder:
  #   base_url: http://127.0.0.1:8080/v1
  #   model: mlx-community/Qwen3.6-35B-A3B-8bit
  #   max_tokens: 4096

run:
  # Attempt order for sdd implement. After an attempt that needs escalation
  # (VERIFY_FAILED / EXHAUSTED / BUDGET / MALFORMED / WEDGED) the repo is reset to
  # base and retried on the next tier. A 1-entry ladder never escalates.
  # Default when omitted: [coder, planner].
  escalation_ladder: [flash, coder, planner, pro]
  agent_turns: 100        # per-attempt turn cap (default 40)
  agent_tokens: 6000000   # per-attempt token cap (default 1500000)
  token_budget: 30000000  # whole-run cap; the run pauses at exit 3 when it is hit
  gradle_workers: 2       # concurrent build subprocesses, gradle and npm alike — the resource
                          # being protected is the machine, so one pool covers both
  model_concurrency: 2    # concurrent model calls

# Verification tasks to skip per repo — the report marks these "not locally verified"
# rather than pretending they passed:
# verification_exclusions:
#   some-repo: [integrationTest]

# Gradle daemon JDKs for old wrappers (filled per machine):
# jdk_homes:
#   11: /Library/Java/JavaVirtualMachines/temurin-11.jdk/Contents/Home
#   17: /Library/Java/JavaVirtualMachines/temurin-17.jdk/Contents/Home
#   21: /Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home

# Where node lives, for reading TypeScript and running npm scripts. The npm analogue of
# jdk_homes, and needed for the same reason: repos pin their node version with .nvmrc, and under
# nvm the executable sits somewhere an interactive shell's PATH knows about but a launcher's does
# not. Omit to take node from PATH. A node_home that does not exist is an error rather than a
# quiet fallback, so a typo here cannot silently change which compiler reads the estate.
# node_home: /Users/me/.nvm/versions/node/v22.11.0

excludes: []              # workspace directories to skip

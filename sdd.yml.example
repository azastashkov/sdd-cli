# Copy to <workspace>/sdd.yml — the directory containing all estate checkouts.
retrieval: fts            # fts is the only backend that exists — every command retrieves with
                          # SQLite FTS5. `embeddings` is rejected at load time rather than
                          # accepted and ignored: there is no embeddings backend to honor it.
                          # This key can be omitted; fts is the default.

# Every key under `models:` is an endpoint you can name in `run.escalation_ladder`.
# `planner` is also used directly for impact seeding and Gate-1 plan drafting, and
# `coder` for repo cards, so keep both defined even if the ladder names others.
#
# api_key resolves ${ENV_VAR} at load time. Read-only commands (review, status,
# clean) never call a model and never need the credential; implement, plan, index
# and doctor fail at first use if it is missing.
models:
  coder:                  # tier 1: most repos resolve here
    base_url: https://routerai.ru/api/v1
    model: qwen/qwen3.5-397b-a17b
    api_key: ${ROUTER_AI_API_KEY}
    max_tokens: 8192
    extra_body:
      # Thinking models spend the whole completion budget on reasoning and return
      # finish_reason=length with empty content. Disable it for structured work.
      chat_template_kwargs:
        enable_thinking: false
  planner:                # tier 2, and the whole-estate synthesis model
    base_url: https://api.deepseek.com/v1
    model: deepseek-v4-flash
    api_key: ${DEEPSEEK_API_KEY}
    # drafting a Gate-1 plan needs ~2x the seeding budget; 16384 truncates on medium estates
    max_tokens: 32768
  pro:                    # tier 3: last resort
    base_url: https://api.deepseek.com/v1
    model: deepseek-v4-pro
    api_key: ${DEEPSEEK_API_KEY}
    max_tokens: 32768

  # Local alternative for `coder` (Apple Silicon, ~40 GB): run scripts/serve-qwen.sh
  # and REPLACE the `coder:` block above with the one below — do not uncomment it
  # here, or `models:` ends up with two `coder:` keys. Keeps every token on the
  # machine.
  # coder:
  #   base_url: http://127.0.0.1:8080/v1
  #   model: mlx-community/Qwen3.6-35B-A3B-8bit
  #   max_tokens: 4096

  # ------------------------------------------------------------------------
  # CLOSED CORPORATE NETWORK: the same three tiers, over mutual TLS
  # ------------------------------------------------------------------------
  # The corporate gateway serves the SAME models under the SAME tier names as
  # the blocks above — only the transport differs. So REPLACE the coder/
  # planner/pro blocks above with the three below; do not uncomment them here,
  # or `models:` ends up with two `coder:` keys. `model:` values are unchanged,
  # and `run.escalation_ladder` needs no edit at all.
  #
  # What changes: one base_url for every tier, no api_key (the client
  # certificate IS the credential — sdd sends no Authorization header when
  # api_key is absent), and a tls: block per tier.
  #
  # cert/key are the exact PEM pair `curl --cert <cert> --key <key>` uses for
  # the same gateway, so a working curl maps straight onto this: --cert →
  # tls.cert, --key → tls.key, --tlsv1.2 --tls-max 1.2 → tls.protocols. Only
  # PEM key forms are supported — unencrypted PKCS#8 (BEGIN PRIVATE KEY) and
  # encrypted PKCS#8 (BEGIN ENCRYPTED PRIVATE KEY, needs key_password). A
  # PKCS#1 (BEGIN RSA PRIVATE KEY) or SEC1 (BEGIN EC PRIVATE KEY) key is
  # rejected with the exact `openssl pkcs8 -topk8 -nocrypt` command to convert
  # it.
  #
  # If the gateway is the GigaChat one, add `wire: gigachat` to each tier and point
  # base_url straight at it — no gpt2giga proxy in between.
  #
  # `wire: gigachat` is NOT optional there. It is what makes sdd declare its tools as
  # GigaChat's `functions: [...]` instead of OpenAI's `tools: [...]`, and a gateway that
  # reads only the former ACCEPTS the latter, answers HTTP 200, and hands the model NO
  # TOOLS. The model then invents a plausible tool name out of the request's own wording,
  # which reads like a model fault and is not. Sending one conversation twice, changing
  # only that key (gigachat-tools-vs-functions.sh): under `tools[]` the reply was "there is
  # no tool specified in the conversation"; under `functions[]`, a structured function_call.
  #
  # Translating `tools` into `functions` is also what gpt2giga was really doing for sdd, so
  # the DECLARATION-COUNT ceiling once blamed on that proxy — one declaration 20/20, six
  # 13/20, nine 0/20, fast uniform HTTP 500s — was measured through the one component making
  # tool calling work. Direct, with `wire: gigachat`, the same gateway carries 1/6/10/11/12
  # declarations at 50/50. Both `single_tool` settings can stay off.
  #
  # (An earlier note here said captured traffic showed this gateway accepting OpenAI `tools`
  # as-is. That capture was a DIFFERENT service surface in the same estate; it is wrong
  # about this one. See README, "Talking to a GigaChat gateway directly".)
  #
  # Run `sdd doctor` first — or `sdd doctor --endpoint coder` to iterate on
  # one tier. It validates cert/key existence, whether the key parses, and the
  # certificate's expiry BEFORE probing, because an expired client cert is the
  # most common mTLS failure and the handshake alert it produces on its own
  # (bad_certificate) says nothing useful.
  #
  # coder:
  #   base_url: ${MODEL_URL}             # MODEL_URL MINUS its /chat/completions
  #                                      # suffix — sdd appends that itself, so a
  #                                      # full completions URL here becomes
  #                                      # /chat/completions/chat/completions
  #   model: Qwen3.5-397b              # EXACT case from the gateway's /models listing —
  #                                      # `sdd doctor --endpoint <name>` names the models it
  #                                      # serves and flags a name that differs only in case
  #   max_tokens: 8192
  #   # tool_calls: text                 # PER-TIER, and probably NOT needed here. It is
  #                                      # only for a gateway that accepts declarations
  #                                      # but returns the call as plain content, in
  #                                      # neither `tool_calls` nor `function_call`.
  #                                      # Under `wire: gigachat` this gateway answers
  #                                      # with a STRUCTURED `function_call`, which sdd
  #                                      # reads whatever this is set to — so the text
  #                                      # path never fires. It was needed while sdd was
  #                                      # sending `tools[]`: the model was given no
  #                                      # tools and wrote a pseudo-call as prose, and
  #                                      # `text` was what parsed that. Fixing the
  #                                      # declarations removed the reason for it.
  #                                      # Harmless to keep as a fallback, since the text
  #                                      # path only runs when nothing structured
  #                                      # arrived. To find out for your gateway, drop it
  #                                      # and run
  #                                      #   sdd doctor --endpoint <name> \
  #                                      #     --tools-count 11 --tools-repeat 3
  #                                      # Before reaching for it at all, try extra_body
  #                                      # tool_choice: auto / function_call: auto — an
  #                                      # endpoint doing its own parsing beats this
  #   wire: gigachat                     # REQUIRED on a GigaChat gateway, not a tuning
  #                                      # option: it is what makes sdd declare tools as
  #                                      # `functions: [...]` instead of OpenAI's
  #                                      # `tools: [...]`. A gateway that reads only the
  #                                      # former ACCEPTS the latter, answers HTTP 200, and
  #                                      # hands the model NO TOOLS — after which the model
  #                                      # invents a plausible tool name out of the request's
  #                                      # own wording, which reads like a model fault and is
  #                                      # not. Measured both ways with
  #                                      # gigachat-tools-vs-functions.sh. Omit (or `openai`)
  #                                      # for every other endpoint
  #   tls: &corp_tls
  #     cert: ${MODEL_CERT_PATH}
  #     key: ${MODEL_KEY_PATH}
  #     # key_password: ${MODEL_KEY_PASSWORD}  # only for BEGIN ENCRYPTED
  #                                               # PRIVATE KEY; omit for a
  #                                               # plain BEGIN PRIVATE KEY
  #     protocols: [TLSv1.2]                      # what `curl --tlsv1.2
  #                                               # --tls-max 1.2` pins. Omit to
  #                                               # leave the JDK's own version
  #                                               # negotiation alone; set it
  #                                               # when a gateway rejects the
  #                                               # JDK's TLS 1.3 default
  #     # truststore: /path/to/corp-ca.pem       # ONLY if the JDK's cacerts
  #                                               # does not already trust this
  #                                               # gateway's CA. A working curl
  #                                               # to the same URL does NOT mean
  #                                               # the JDK trusts the chain:
  #                                               # curl reads the OS store, the
  #                                               # JDK reads only its own
  #                                               # cacerts. This is the most
  #                                               # likely first failure here,
  #                                               # and it surfaces as
  #                                               # `PKIX path building failed`.
  #                                               # Either a PEM bundle (the same
  #                                               # file `curl --cacert` takes) or
  #                                               # a JKS/PKCS12 keystore; the
  #                                               # format is detected from the
  #                                               # contents, so no keytool
  #                                               # conversion step is needed
  #     # truststore_password: ${MODEL_TRUSTSTORE_PASSWORD}   # required for
  #                                               # anything keytool produced —
  #                                               # keytool refuses to create a
  #                                               # password-less store. Omit for
  #                                               # a PEM bundle, which has no
  #                                               # password (a stale one here is
  #                                               # ignored, not an error)
  #   extra_body:
  #     repetition_penalty: 1
  # planner:
  #   base_url: ${MODEL_URL}
  #   model: DeepSeek-V4-Pro
  #   max_tokens: 32768                  # see the WARNING below about thinking models
  #   wire: gigachat
  #   tls: *corp_tls                     # same cert, key and CA for every tier
  #   extra_body:
  #     repetition_penalty: 1
  # pro:
  #   base_url: ${MODEL_URL}
  #   model: GigaChat-3-Ultra
  #   max_tokens: 32768
  #   wire: gigachat
  #   tls: *corp_tls
  #   extra_body:
  #     repetition_penalty: 1
  #
  # vision is NOT a tier — it is not on run.escalation_ladder and nothing escalates to it. It
  # exists only for atlassian.describe_images, which needs an endpoint that can accept an image,
  # and none of the three tiers above can: only GigaChat models take images, and only 2 Max and
  # 2 Pro document doing so.
  # vision:
  #   base_url: ${MODEL_URL}
  #   model: GigaChat-2-Max        # NOT 3-Ultra: its model page publishes no Input/Output block
  #   max_tokens: 4096             # a description, not an agent turn
  #   wire: gigachat               # mandatory — no other wire has a file store to upload to
  #   tls: *corp_tls
  #
  # All three tiers above were verified on a REAL agent turn — declarations the model can
  # call, a tool result in history, max_tokens 32768 — returning 3/3 with non-empty content
  # (gigachat-toolresult-probe.py, variant 14). Measured 2026-08-22; `GigaChat-2-Max` and
  # `glm-5.1` pass the same check, so five models on this gateway are known usable and the
  # choice between them is not a survivability one.
  #
  # That says nothing about IMAGES. Only GigaChat models take them, and only 2 Max and 2 Pro
  # document it — `GigaChat-3-Ultra`'s model page publishes no Input/Output block at all. A
  # tier that passes variant 14 is not thereby a vision endpoint.
  #
  # That check is worth repeating for any model you swap in, because A THINKING MODEL CAN BE
  # UNUSABLE AT EVERY max_tokens and it does not look like that from outside. Measured on
  # this gateway, `DeepSeek-v4-Flash` spent its whole completion budget reasoning and
  # returned EMPTY content at 512, 1024 and 4096, then failed to finish inside 120s at 8192.
  # No working value existed. The symptom was a run that appeared to HANG on its second turn
  # while the first was fine — and the fix is a different model, not a different number.
  #
  # `sdd doctor --tools-count` will NOT catch it: that is a first-turn probe, two messages
  # with no history, and the unusable model scored 50/50 on it. A green sweep says the
  # endpoint accepts declarations; it says nothing about surviving turn two.

run:
  # Attempt order for sdd implement. After an attempt that needs escalation
  # (VERIFY_FAILED / EXHAUSTED / BUDGET / MALFORMED / WEDGED) the repo is reset to
  # base and retried on the next tier. A 1-entry ladder never escalates.
  # Default when omitted: [coder, planner].
  escalation_ladder: [coder, planner, pro]
  agent_turns: 100        # per-attempt turn cap (default 40)
  agent_tokens: 6000000   # per-attempt token cap (default 1500000)
  token_budget: 30000000  # whole-run cap; the run pauses at exit 3 when it is hit
  gradle_workers: 2       # concurrent build subprocesses, gradle and npm alike — the resource
                          # being protected is the machine, so one pool covers both
  model_concurrency: 2    # concurrent model calls
  # single_tool: false    # Advertise the coding agent's six operations as ONE tool declaration
                          # carrying an `action` argument. The implement-side twin of
                          # explore.single_tool, for the same endpoint defect and with the same
                          # cost. Measured on one gateway with an identical request repeated
                          # twenty times: 20/20 succeeded with one declaration, 13/20 with six,
                          # 0/20 with nine. Leave it off unless `sdd implement` is returning
                          # HTTP 500 or stalling on retries.

# sdd explore's ceilings. These exist so the read-only estate walk TERMINATES and is
# reproducible, not to save tokens — omit the block entirely to take the defaults.
# explore:
#   turns: 200            # per-run turn cap (default 200; the coding agent's 40 cannot roam 53 repos)
#   tokens: 8000000       # per-run token cap (default 8000000)
#   wall_seconds: 7200    # per-run wall clock (default 7200)
#   context_soft_cap: 200000   # prompt tokens before the window starts evicting (default 200000)
#   single_tool: false    # Advertise every explorer operation as ONE tool declaration carrying
#                         # an `action` argument, instead of one declaration each.
#                         # Only for an endpoint whose function-calling path breaks as the
#                         # declaration set grows: measured on one gateway, ordinary
#                         # identifier-shaped text in the prompt failed every attempt at five
#                         # declarations and none at one. It costs real quality — a schema per
#                         # operation is what tells the model which arguments each one takes —
#                         # so leave it off unless `sdd explore` is returning HTTP 500 from the
#                         # endpoint.
#                         #
#                         # The count it collapses is TEN by default, and each of the two
#                         # optional tools is advertised only when its flag asks for it:
#                         # `ask_user_question` with --interactive, `git_history` with --since.
#                         # So a run passing both is at twelve — the worst case on a gateway
#                         # that degrades with the count, and the one where this setting earns
#                         # itself. It costs nothing extra there: both collapse into the same
#                         # single declaration as everything else.
#   max_questions: 10     # How many questions `sdd explore --interactive` may put to you in one
#                         # run (default 10). The only ceiling on human minutes: waiting spends
#                         # no turns, no tokens, and is deliberately excluded from wall_seconds,
#                         # so without this a model could turn a survey into an interrogation.
#                         # Ignored entirely without --interactive, where the tool is not even
#                         # advertised to the model.

# Verification tasks to skip per repo — the report marks these "not locally verified"
# rather than pretending they passed:
# verification_exclusions:
#   some-repo: [integrationTest]

# Gradle daemon JDKs for old wrappers (filled per machine):
# jdk_homes:
#   11: /Library/Java/JavaVirtualMachines/temurin-11.jdk/Contents/Home
#   17: /Library/Java/JavaVirtualMachines/temurin-17.jdk/Contents/Home
#   21: /Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home

# Where node lives, for reading TypeScript and running npm scripts. The npm analogue of
# jdk_homes, and needed for the same reason: repos pin their node version with .nvmrc, and under
# nvm the executable sits somewhere an interactive shell's PATH knows about but a launcher's does
# not. Omit to take node from PATH. A node_home that does not exist is an error rather than a
# quiet fallback, so a typo here cannot silently change which compiler reads the estate.
# node_home: /Users/me/.nvm/versions/node/v22.11.0

# Where Gradle lives, for repos that do NOT ship a wrapper. A repo's own ./gradlew always wins when
# it is present and executable: a wrapper pins the Gradle version its repo was written for, and this
# estate spans several, so preferring one configured Gradle over a present wrapper would run an old
# repo on a new Gradle. This is only the fallback. Omit to take gradle from $SDD_GRADLE then PATH.
# A gradle_home that does not exist is an error rather than a quiet fallback, same rule as node_home.
# gradle_home: /Users/me/.sdkman/candidates/gradle/current

excludes: []              # workspace directories to skip

# Requirement ingestion (Jira issues, Confluence pages) and Bitbucket source control, for a self-
# hosted Data Center estate on a closed corporate network. The whole block is optional — sdd.yml
# with no atlassian: key changes sdd doctor's output not at all — and each site under it (jira,
# confluence, bitbucket) is independently optional too: declare only the ones this estate uses.
# atlassian:
#   tls:
#     # The corporate CA chain, when self-hosted Jira/Confluence/Bitbucket sit behind a certificate
#     # the JDK's bundled cacerts does not trust (the common case on a closed network). Detected by
#     # extension: .jks is JKS, .p12/.pfx is PKCS12, anything else defaults to PKCS12 (the JDK's own
#     # default keystore type). A path that does not exist is a hard error at first use, never a
#     # quiet fallback to the JDK default truststore — same rule node_home follows above, for the
#     # same reason: a typo here must not silently change which trust anchors are in play. There is
#     # no --insecure flag and none will be added; fix the truststore, do not disable verification.
#     truststore: /etc/ssl/corp-ca.jks
#     truststore_password: ${CORP_TRUSTSTORE_PASSWORD}
#   proxy:
#     # A forward proxy fronting egress. no_proxy lists hosts that bypass it — typically the
#     # Atlassian hosts themselves, often reachable directly even when the proxy is required for
#     # everything else. Matches a no_proxy entry on an exact host or a dotted suffix
#     # (corp.local covers jira.corp.local, not notcorp.local), case-insensitively.
#     host: proxy.corp.local
#     port: 8080
#     no_proxy: [jira.corp.local, confluence.corp.local, bitbucket.corp.local]
#
#   # base_url is structural and fails config loading immediately if missing, like models.<name>.
#   # base_url does above. token resolves ${VAR} the same way models.<name>.api_key does: an unset
#   # variable does NOT fail loading — sdd index must not need a Bitbucket token it will never use —
#   # it is raised only when something actually calls this site, naming the variable to reissue
#   # (PATs expire) in the error.
#   jira:
#     base_url: ${JIRA_URL}       # this site's base URL, e.g. https://jira.corp.local
#     token: ${JIRA_API_KEY}
#     timeout_seconds: 30       # default when omitted
#   confluence:
#     base_url: ${CONFLUENCE_URL} # e.g. https://confluence.corp.local
#     token: ${CONFLUENCE_API_KEY}
#   # describe_images names a models: key used to describe a Confluence page's IMAGES, so a
#   # sequence diagram or a UI mockup becomes text the planner can turn into requirements
#   # instead of an inert [attachment: name] marker. ABSENT MEANS OFF, and off is the default:
#   # one image costs a download, an upload, TWO model calls and a delete, and a real page in
#   # this estate carried 26 attachments. Results are cached on page+file+VERSION+model+prompt,
#   # so a re-run describes nothing and does not rewrite a spec somebody has reviewed.
#   #
#   # It must name a `wire: gigachat` endpoint — no other wire has a file store to upload to,
#   # and config loading fails if it does not. Only GigaChat models take images at all, and
#   # only 2 Max and 2 Pro document doing so.
#   #
#   # Each image is read TWICE and the two readings compared. Measured 2026-08-22: two reads of
#   # one mapping form disagreed on the counterparty bank AND the product name, while two reads
#   # of a state diagram agreed exactly. Structure survives; dense values do not. So the
#   # description enters the spec MARKED as model-generated and unverified, followed by a line
#   # naming whatever the two reads did not agree on. Read that line before trusting a value.
#   # describe_images: vision
#   bitbucket:
#     base_url: ${BITBUCKET_URL}  # e.g. https://bitbucket.corp.local
#     token: ${BITBUCKET_API_KEY}
#     project: TRADING           # the Bitbucket project key repos live under
#     default_reviewers: [alice, bob]
#     # git_username is sent with the PUSH only, never with REST. sdd sends the placeholder
#     # `x-token-auth` by default, on the documented belief that Data Center's HTTP
#     # personal-access-token auth carries the identity in the token itself. Measured
#     # 2026-08-23: at least one instance does NOT — it answered `not authorized` on the read
#     # that precedes the push. Set this to your own username there; the token stays the
#     # password. A wrong value fails config loading rather than surfacing as an authorization
#     # error from git several steps later.
#     git_username: a.name
#
#   follow_depth: 1             # how many hops of CONFLUENCE LINK-following (bare URLs found in a
#                                 # fetched page's own text) requirement ingestion follows — linked
#                                 # Jira issue traversal is fixed at one level and is NOT affected by
#                                 # this setting; see max_linked_issues below for that cap instead
#   max_pages: 20                # total Confluence page-fetch cap across the whole run, so a huge
#                                 # or looping link graph cannot run away
#   max_linked_issues: 10        # linked Jira issue cap per issue, same reason
#   write_back: none             # none | comment — off by default; a tool that can silently start
#                                 # commenting on tickets needs an explicit opt-in
#   pull_requests: false         # off by default, same reason
#
# Diagnosing Atlassian access on a closed network:
#   sdd plan --fetch-only PROJ-123      fetch the sources, print their provenance and sizes, and
#                                       stop — no model is called, nothing is written, so Jira and
#                                       Confluence can be tested independently of the model gateway
#   SDD_ATLASSIAN_DUMP=1 sdd plan …     record every Atlassian request and response as JSONL to
#                                       .sdd/atlassian-wire.jsonl (already gitignored); set it to a
#                                       path to write elsewhere. Request headers are never written;
#                                       allowlisted response headers (Location, Retry-After,
#                                       Content-Type, …) are, because a tiny-link redirect and a
#                                       rewriting proxy show up nowhere else. Configured tokens are
#                                       redacted; ticket and page text is NOT.

# Runtime composition: which repo builds a bundle a host application loads at run time. Declared
# rather than derived — a manifest says the host loads /mfe/a/trading-mfe-a.js, but which repo
# BUILDS that bundle lives in a bundler config sdd does not read, so inferring it from the filename
# would put a guess in the knowledge base wearing the same clothes as a parsed fact. Any remote
# left unmapped is listed in the curation report.
# runtime_edges:
#   - host_repo: trading-frontend-root-config
#     remote: mfe_a
#     module_repo: trading-mfe-a
